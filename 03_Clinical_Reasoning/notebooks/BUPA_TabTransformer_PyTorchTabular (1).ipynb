import os
from pathlib import Path

import pandas as pd
import numpy as np

from sklearn.model_selection import train_test_split
from sklearn.metrics import (
    classification_report,
    accuracy_score,
    confusion_matrix
)

from pytorch_tabular import TabularModel
from pytorch_tabular.models import TabTransformerConfig
from pytorch_tabular.config import (
    DataConfig,
    TrainerConfig,
    OptimizerConfig
)


# ============================================================
# 1. PATHS
# ============================================================

DATA_PATH = (
    "/content/drive/MyDrive/"
    "Clinical Reasoning Agent/liver+disorders/bupa.data"
)

MODEL_DIR = Path(
    "/content/LiverAI-MultiAgent/"
    "models/clinical_reasoning/"
    "tabtransformer_bupa"
)

MODEL_DIR.parent.mkdir(
    parents=True,
    exist_ok=True
)

print("Dataset :", DATA_PATH)
print("Model   :", MODEL_DIR)


# ============================================================
# 2. LOAD DATASET BUPA
# ============================================================

cols = [
    "mcv",
    "alkphos",
    "sgpt",
    "sgot",
    "gammagt",
    "drinks",
    "selector"
]

df = pd.read_csv(
    DATA_PATH,
    names=cols
)

print("\nDataset shape:", df.shape)
print(df.head())


# ============================================================
# 3. TARGET
# ============================================================

df["selector"] = (
    df["selector"]
    .astype(int) - 1
)


# ============================================================
# 4. CONTINUOUS FEATURES
# ============================================================

continuous_cols = [
    "mcv",
    "alkphos",
    "sgpt",
    "sgot",
    "gammagt",
    "drinks"
]

df[continuous_cols] = (
    df[continuous_cols]
    .astype(float)
)


# ============================================================
# 5. SPLIT
# ============================================================

train, test = train_test_split(
    df,
    test_size=0.2,
    random_state=42,
    stratify=df["selector"]
)

print("\nTrain:", train.shape)
print("Test :", test.shape)


# ============================================================
# 6. DATA CONFIG
# ============================================================

data_config = DataConfig(
    target=["selector"],
    continuous_cols=continuous_cols,
    categorical_cols=[]
)


# ============================================================
# 7. TRAINER CONFIG
# ============================================================

trainer_config = TrainerConfig(
    max_epochs=50,
    batch_size=64,
    accelerator="auto"
)


# ============================================================
# 8. OPTIMIZER
# ============================================================

optimizer_config = OptimizerConfig()


# ============================================================
# 9. TABTRANSFORMER CONFIG
# ============================================================

model_config = TabTransformerConfig(
    task="classification",
    learning_rate=1e-3
)


# ============================================================
# 10. CREATE MODEL
# ============================================================

model = TabularModel(
    data_config=data_config,
    model_config=model_config,
    optimizer_config=optimizer_config,
    trainer_config=trainer_config
)


# ============================================================
# 11. TRAIN
# ============================================================

print("\n" + "=" * 70)
print("TRAINING TABTRANSFORMER")
print("=" * 70)

model.fit(
    train=train,
    validation=test
)


# ============================================================
# 12. PREDICTION
# ============================================================

print("\n" + "=" * 70)
print("EVALUATION")
print("=" * 70)

pred = model.predict(test)

print("\nPrediction columns:")
print(pred.columns.tolist())

print("\nPrediction preview:")
print(pred.head())


# ============================================================
# 13. GET PREDICTIONS
# ============================================================

prediction_col = [
    c for c in pred.columns
    if "prediction" in c.lower()
]

if len(prediction_col) == 0:
    raise Exception(
        "Aucune colonne prediction trouvée."
    )

prediction_col = prediction_col[0]

y_pred = (
    pred[prediction_col]
    .astype(int)
    .values
)

y_true = test["selector"].values


# ============================================================
# 14. RESULTS
# ============================================================

accuracy = accuracy_score(
    y_true,
    y_pred
)

print("\nAccuracy:")
print(accuracy)

print("\nClassification report:")
print(
    classification_report(
        y_true,
        y_pred
    )
)

print("\nConfusion matrix:")
print(
    confusion_matrix(
        y_true,
        y_pred
    )
)


# ============================================================
# 15. SAVE MODEL IN LIVERAI PROJECT
# ============================================================

print("\n" + "=" * 70)
print("SAVING MODEL")
print("=" * 70)

model.save_model(
    str(MODEL_DIR)
)

print("\n✅ Model saved successfully")
print("📁", MODEL_DIR)


# ============================================================
# 16. VERIFY
# ============================================================

if MODEL_DIR.exists():
    print("\n✅ MODEL DIRECTORY EXISTS")

    print("\nFiles:")
    for item in MODEL_DIR.rglob("*"):
        print(" -", item)

else:
    raise FileNotFoundError(
        f"Model directory not found: {MODEL_DIR}"
    )
