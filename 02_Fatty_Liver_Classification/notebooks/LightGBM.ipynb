# ==========================================================
# LiverAI-MultiAgent
# Fatty Liver Classification - LightGBM
#
# DATA:
#   nafld1.csv -> patient information + status
#   nafld2.csv -> longitudinal laboratory measurements
#
# TARGET:
#   status
#
# IMPORTANT:
#   nwtco.csv is NOT used here.
# ==========================================================


# ==========================================================
# 1. INSTALLATION
# ==========================================================

!pip install -q lightgbm joblib


# ==========================================================
# 2. IMPORTS
# ==========================================================

import os
import joblib
import numpy as np
import pandas as pd

from google.colab import drive

from sklearn.model_selection import train_test_split
from sklearn.impute import SimpleImputer

from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix,
    roc_auc_score
)

from lightgbm import LGBMClassifier


# ==========================================================
# 3. GOOGLE DRIVE
# ==========================================================

drive.mount("/content/drive")

print("✅ Google Drive mounted")


# ==========================================================
# 4. PATHS
# ==========================================================

DATA_DIR = "/content/drive/MyDrive/FattyLiver Agent/DATA"

NAFLD1_PATH = os.path.join(
    DATA_DIR,
    "nafld1.csv"
)

NAFLD2_PATH = os.path.join(
    DATA_DIR,
    "nafld2.csv"
)


# Check files

for path in [
    NAFLD1_PATH,
    NAFLD2_PATH
]:

    if not os.path.exists(path):

        raise FileNotFoundError(
            f"\n❌ File not found:\n{path}"
        )

    print("✅ Found:", path)


# ==========================================================
# 5. LOAD DATA
# ==========================================================

nafld1 = pd.read_csv(
    NAFLD1_PATH
)

nafld2 = pd.read_csv(
    NAFLD2_PATH
)


print("\n" + "=" * 70)
print("DATASETS")
print("=" * 70)

print(
    "NAFLD1:",
    nafld1.shape
)

print(
    "NAFLD2:",
    nafld2.shape
)


# ==========================================================
# 6. REMOVE UNNAMED COLUMNS
# ==========================================================

nafld1 = nafld1.drop(
    columns=[
        c for c in nafld1.columns
        if c.lower().startswith("unnamed")
    ],
    errors="ignore"
)

nafld2 = nafld2.drop(
    columns=[
        c for c in nafld2.columns
        if c.lower().startswith("unnamed")
    ],
    errors="ignore"
)


# ==========================================================
# 7. CHECK NAFLD1
# ==========================================================

print("\nNAFLD1 columns:")

print(
    nafld1.columns.tolist()
)


# ==========================================================
# 8. CHECK NAFLD2
# ==========================================================

print("\nNAFLD2 columns:")

print(
    nafld2.columns.tolist()
)


# ==========================================================
# 9. CLEAN TYPES
# ==========================================================

nafld1["id"] = pd.to_numeric(
    nafld1["id"],
    errors="coerce"
)

nafld2["id"] = pd.to_numeric(
    nafld2["id"],
    errors="coerce"
)

nafld2["value"] = pd.to_numeric(
    nafld2["value"],
    errors="coerce"
)

nafld2["days"] = pd.to_numeric(
    nafld2["days"],
    errors="coerce"
)


# ==========================================================
# 10. REMOVE INVALID IDS
# ==========================================================

nafld1 = nafld1.dropna(
    subset=["id"]
)

nafld2 = nafld2.dropna(
    subset=["id"]
)


# ==========================================================
# 11. CREATE LABORATORY FEATURES
# ==========================================================

print("\n" + "=" * 70)
print("CREATING LAB FEATURES")
print("=" * 70)


# We aggregate repeated measurements
# for every patient and every laboratory test.

lab_features = (
    nafld2
    .groupby(
        ["id", "test"]
    )["value"]
    .agg(
        [
            "mean",
            "min",
            "max",
            "std"
        ]
    )
    .reset_index()
)


print(
    "Long-format laboratory table:",
    lab_features.shape
)


# ==========================================================
# 12. PIVOT LAB FEATURES
# ==========================================================

lab_wide = lab_features.pivot(
    index="id",
    columns="test",
    values=[
        "mean",
        "min",
        "max",
        "std"
    ]
)


# Flatten column names

lab_wide.columns = [

    f"{stat}_{test}"

    for stat, test
    in lab_wide.columns
]


lab_wide = lab_wide.reset_index()


print(
    "\nWide laboratory table:",
    lab_wide.shape
)

print(
    "\nLaboratory features:"
)

print(
    lab_wide.columns.tolist()
)


# ==========================================================
# 13. MERGE PATIENT + LAB DATA
# ==========================================================

df = pd.merge(

    nafld1,

    lab_wide,

    on="id",

    how="left"

)


print("\n" + "=" * 70)
print("MERGED DATASET")
print("=" * 70)

print(
    "Shape:",
    df.shape
)


# ==========================================================
# 14. TARGET
# ==========================================================

TARGET = "status"


if TARGET not in df.columns:

    raise ValueError(
        f"❌ Target '{TARGET}' not found."
    )


# Remove rows without target

df = df.dropna(
    subset=[TARGET]
)


# Make target integer

df[TARGET] = pd.to_numeric(
    df[TARGET],
    errors="coerce"
)

df = df.dropna(
    subset=[TARGET]
)

df[TARGET] = df[TARGET].astype(int)


print("\nTarget distribution:")

print(
    df[TARGET].value_counts()
)


# ==========================================================
# 15. FEATURES
# ==========================================================

# DO NOT use:
# - status -> target
# - futime -> follow-up information
# - id -> identifier
# - case.id -> identifier

DROP_COLUMNS = [

    "status",
    "futime",
    "id",
    "case.id"

]


X = df.drop(
    columns=DROP_COLUMNS,
    errors="ignore"
)

y = df[TARGET]


# ==========================================================
# 16. KEEP NUMERIC FEATURES
# ==========================================================

X = X.select_dtypes(
    include=[np.number]
)


print("\n" + "=" * 70)
print("FEATURES")
print("=" * 70)

print(
    X.columns.tolist()
)

print(
    "\nNumber of features:",
    X.shape[1]
)


# ==========================================================
# 17. REMOVE FEATURES WITH NO INFORMATION
# ==========================================================

all_missing = [
    col
    for col in X.columns
    if X[col].notna().sum() == 0
]


if all_missing:

    X = X.drop(
        columns=all_missing
    )

    print(
        "\nRemoved completely empty features:"
    )

    print(
        all_missing
    )


# ==========================================================
# 18. TRAIN / TEST SPLIT
# ==========================================================

X_train, X_test, y_train, y_test = train_test_split(

    X,

    y,

    test_size=0.20,

    random_state=42,

    stratify=y

)


print("\nTrain:", X_train.shape)

print(
    "Test :",
    X_test.shape
)


# ==========================================================
# 19. IMPUTATION
# ==========================================================

imputer = SimpleImputer(
    strategy="median"
)


X_train = pd.DataFrame(

    imputer.fit_transform(X_train),

    columns=X_train.columns,

    index=X_train.index

)


X_test = pd.DataFrame(

    imputer.transform(X_test),

    columns=X_test.columns,

    index=X_test.index

)


# ==========================================================
# 20. LIGHTGBM
# ==========================================================

print("\n" + "=" * 70)
print("TRAINING LIGHTGBM")
print("=" * 70)


lgbm = LGBMClassifier(

    n_estimators=300,

    learning_rate=0.03,

    num_leaves=31,

    max_depth=-1,

    min_child_samples=20,

    subsample=0.8,

    colsample_bytree=0.8,

    reg_alpha=0.1,

    reg_lambda=0.1,

    class_weight="balanced",

    random_state=42,

    n_jobs=-1

)


# ==========================================================
# 21. TRAIN
# ==========================================================

lgbm.fit(

    X_train,

    y_train

)


print(
    "✅ LightGBM training completed"
)


# ==========================================================
# 22. PREDICTION
# ==========================================================

y_pred = lgbm.predict(
    X_test
)


y_proba = lgbm.predict_proba(
    X_test
)


# ==========================================================
# 23. ACCURACY
# ==========================================================

accuracy = accuracy_score(

    y_test,

    y_pred

)


print("\n" + "=" * 70)
print("RESULTS")
print("=" * 70)

print(
    f"Accuracy: {accuracy * 100:.2f}%"
)


# ==========================================================
# 24. ROC-AUC
# ==========================================================

if len(np.unique(y)) == 2:

    auc = roc_auc_score(

        y_test,

        y_proba[:, 1]

    )

    print(
        f"ROC-AUC: {auc:.4f}"
    )


# ==========================================================
# 25. CLASSIFICATION REPORT
# ==========================================================

print(
    "\nClassification Report:"
)

print(

    classification_report(

        y_test,

        y_pred

    )

)


# ==========================================================
# 26. CONFUSION MATRIX
# ==========================================================

print(
    "\nConfusion Matrix:"
)

print(

    confusion_matrix(

        y_test,

        y_pred

    )

)


# ==========================================================
# 27. FEATURE IMPORTANCE
# ==========================================================

importance = pd.DataFrame({

    "feature": X.columns,

    "importance": lgbm.feature_importances_

})


importance = importance.sort_values(

    "importance",

    ascending=False

)


print(
    "\nTop 20 features:"
)

display(
    importance.head(20)
)


# ==========================================================
# 28. SAVE MODEL
# ==========================================================

MODEL_DIR = (
    "/content/LiverAI-MultiAgent/"
    "02_Fatty_Liver_Classification/"
    "models"
)


os.makedirs(

    MODEL_DIR,

    exist_ok=True

)


MODEL_PATH = os.path.join(

    MODEL_DIR,

    "FattyLiver_LightGBM.pkl"

)


# Save model + preprocessing + features

model_package = {

    "model": lgbm,

    "imputer": imputer,

    "features": X.columns.tolist(),

    "target": TARGET

}


joblib.dump(

    model_package,

    MODEL_PATH

)


print("\n" + "=" * 70)
print("MODEL SAVED")
print("=" * 70)

print(
    MODEL_PATH
)

print(
    "Size:",
    os.path.getsize(MODEL_PATH),
    "bytes"
)


# ==========================================================
# 29. RELOAD TEST
# ==========================================================

loaded_package = joblib.load(

    MODEL_PATH

)


print(
    "\n✅ Model successfully reloaded"
)

print(
    "Target:",
    loaded_package["target"]
)

print(
    "Number of features:",
    len(
        loaded_package["features"]
    )
)


# ==========================================================
# 30. FINAL CHECK
# ==========================================================

print("\n" + "=" * 70)
print("FINAL CHECK")
print("=" * 70)

print(
    "Dataset rows:",
    len(df)
)

print(
    "Features:",
    len(X.columns)
)

print(
    "Accuracy:",
    f"{accuracy * 100:.2f}%"
)

print(
    "\n✅ FATYY LIVER LIGHTGBM PIPELINE COMPLETED"
)
