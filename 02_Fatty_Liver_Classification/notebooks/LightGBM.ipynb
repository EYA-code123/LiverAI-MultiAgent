# ==========================================================
# BUPA Liver Disorders - LightGBM
# Fatty Liver Agent
# ==========================================================

import pandas as pd
import numpy as np
import os
import joblib

from sklearn.model_selection import (
    train_test_split,
    StratifiedKFold,
    cross_val_score
)

from sklearn.pipeline import Pipeline

from sklearn.impute import SimpleImputer

from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix
)

from lightgbm import LGBMClassifier


# ==========================================================
# 1. Load BUPA Dataset
# ==========================================================

DATASET_PATH = "/content/fatty_liver_data/bupa.data"

columns = [
    "mcv",
    "alkphos",
    "sgpt",
    "sgot",
    "gammagt",
    "drinks",
    "selector"
]

df = pd.read_csv(
    DATASET_PATH,
    header=None,
    names=columns
)


print("=" * 70)
print("BUPA LIVER DISORDERS DATASET")
print("=" * 70)

print("Dataset Shape :", df.shape)

print("\nColumns:")
print(df.columns.tolist())

print("\nFirst 5 rows:")
print(df.head())


# ==========================================================
# 2. Check Missing Values
# ==========================================================

print("\nMissing Values:")
print(df.isnull().sum())


# ==========================================================
# 3. Features / Target
# ==========================================================

TARGET = "selector"

X = df.drop(
    columns=[TARGET]
)

y = df[TARGET].astype(int)


print("\nFeatures:")
print(X.columns.tolist())

print("\nTarget:")
print(TARGET)

print("\nTarget Classes:")
print(sorted(y.unique()))

print("\nClass Distribution:")
print(y.value_counts().sort_index())


# ==========================================================
# 4. Train / Test Split
# ==========================================================

X_train, X_test, y_train, y_test = train_test_split(

    X,
    y,

    test_size=0.20,

    random_state=42,

    stratify=y
)


print("\nTrain Shape :", X_train.shape)
print("Test Shape  :", X_test.shape)


# ==========================================================
# 5. Preprocessing
# ==========================================================

preprocessor = SimpleImputer(
    strategy="median"
)


# ==========================================================
# 6. LightGBM Model
# ==========================================================

lgbm = LGBMClassifier(

    n_estimators=200,

    learning_rate=0.03,

    max_depth=4,

    num_leaves=15,

    min_child_samples=10,

    subsample=0.8,

    colsample_bytree=0.8,

    reg_alpha=0.1,

    reg_lambda=0.1,

    class_weight="balanced",

    random_state=42,

    n_jobs=-1
)


# ==========================================================
# 7. Complete Pipeline
# ==========================================================

model = Pipeline([

    (
        "imputer",
        preprocessor
    ),

    (
        "lightgbm",
        lgbm
    )

])


print("\nModel:")
print(model)


# ==========================================================
# 8. Training
# ==========================================================

print("\n" + "=" * 70)
print("TRAINING LIGHTGBM")
print("=" * 70)

model.fit(
    X_train,
    y_train
)

print("\n✅ Training completed!")


# ==========================================================
# 9. Predictions
# ==========================================================

train_pred = model.predict(X_train)

test_pred = model.predict(X_test)


# ==========================================================
# 10. Evaluation
# ==========================================================

train_accuracy = accuracy_score(
    y_train,
    train_pred
)

test_accuracy = accuracy_score(
    y_test,
    test_pred
)


print("\n" + "=" * 70)
print("MODEL PERFORMANCE")
print("=" * 70)

print(
    f"Train Accuracy : {train_accuracy * 100:.2f}%"
)

print(
    f"Test Accuracy  : {test_accuracy * 100:.2f}%"
)


# ==========================================================
# 11. Classification Report
# ==========================================================

print("\nClassification Report:\n")

print(
    classification_report(
        y_test,
        test_pred
    )
)


# ==========================================================
# 12. Confusion Matrix
# ==========================================================

print("\nConfusion Matrix:\n")

print(
    confusion_matrix(
        y_test,
        test_pred
    )
)


# ==========================================================
# 13. Cross Validation
# ==========================================================

cv = StratifiedKFold(

    n_splits=5,

    shuffle=True,

    random_state=42
)


scores = cross_val_score(

    model,

    X,

    y,

    cv=cv,

    scoring="accuracy",

    n_jobs=-1
)


print("\n" + "=" * 70)
print("5-FOLD CROSS VALIDATION")
print("=" * 70)

print("Scores :", scores)

print(
    f"Mean Accuracy : {scores.mean() * 100:.2f}%"
)

print(
    f"STD           : {scores.std() * 100:.2f}%"
)


# ==========================================================
# 14. Save Model
# ==========================================================

MODEL_DIR = (
    "/content/LiverAI-MultiAgent/"
    "02_Fatty_Liver_Classification/models"
)

os.makedirs(
    MODEL_DIR,
    exist_ok=True
)


MODEL_PATH = os.path.join(
    MODEL_DIR,
    "FattyLiver_LightGBM.pkl"
)


joblib.dump(
    model,
    MODEL_PATH
)


print("\n" + "=" * 70)
print("MODEL SAVED")
print("=" * 70)

print(MODEL_PATH)

print(
    "\nFile exists:",
    os.path.exists(MODEL_PATH)
)
